# All four images must come from the SAME successful GitHub Actions run.
# Use digest references for the strongest guarantee (ghcr.io/...@sha256:...).
WEB_IMAGE=ghcr.io/cochy98/music_beat_detection-web:sha-REPLACE_FULL_COMMIT_SHA
API_IMAGE=ghcr.io/cochy98/music_beat_detection-api:sha-REPLACE_FULL_COMMIT_SHA
WORKER_IMAGE=ghcr.io/cochy98/music_beat_detection-worker:sha-REPLACE_FULL_COMMIT_SHA
REDIS_IMAGE=ghcr.io/cochy98/music_beat_detection-redis:sha-REPLACE_FULL_COMMIT_SHA
MAX_UPLOAD_MB=50
MAX_ACTIVE_JOBS=6
MAX_JOBS_PER_IP=2
MIN_FREE_DISK_MB=5120
MAX_DATA_MB=5120
JOB_TIMEOUT_SECONDS=600
MAX_AUDIO_SECONDS=300
MAX_AUDIO_CHANNELS=2
MAX_SAMPLE_RATE=96000
RETENTION_SECONDS=86400
MAX_QUEUE_AGE_SECONDS=7200
# final0 exceeded 2.5 GB on the measured 5-minute ensemble test.
ALLOW_LARGE_MODEL=false
